# Neon / Postgres (pooled URL with ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — wygeneruj: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
# Lokalnie localhost; na Vercel ustaw produkcyjny URL (https://twoja-domena.vercel.app)
AUTH_URL="http://localhost:3000"

# Vercel Blob — wymagane na produkcji (zdjęcia jadłospisu). Lokalnie opcjonalne (wtedy pliki w public/uploads).
# BLOB_READ_WRITE_TOKEN=""

# Pokaż konta demo na ekranie logowania (tylko staging / lokalnie)
SHOW_DEMO_ACCOUNTS="1"
